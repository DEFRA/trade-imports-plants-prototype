{# Lives here, apart from its controller in src/server/sets-index/, because src/config/nunjucks/nunjucks.js resolves Vision's view root at server/app. #}
{% extends 'shared/layout.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% set mainClasses = "govuk-main-wrapper--l" %}

{% block journeyContent %}
  {% if resetBanner %}
    {{ govukNotificationBanner({
      type: "success",
      titleText: "Success",
      text: "The data in " + resetBanner.setText + " has been reset.",
      role: "alert"
    }) }}
  {% endif %}

  <h1 class="govuk-heading-l">{{ heading }}</h1>
  <p class="govuk-body">{{ body }}</p>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <ul class="govuk-list">
        {% for set in sets %}
          <li class="govuk-!-margin-bottom-8" data-set-id="{{ set.setId }}">
            <h2 class="govuk-heading-m govuk-!-margin-bottom-2">
              <a class="govuk-link" href="{{ set.href }}">{{ set.text }}</a>
            </h2>
            <p class="govuk-body govuk-!-margin-bottom-2">
              {{ govukTag({ text: set.tag.text, classes: set.tag.classes }) }}
              {% if set.researchMode %}
                {{ govukTag({ text: "Research mode on", classes: "govuk-tag--orange" }) }}
              {% endif %}
            </p>
            {% if set.description %}
              <p class="govuk-body govuk-!-margin-bottom-2">{{ set.description }}</p>
            {% endif %}
            {% if set.madeFrom %}
              <p class="govuk-body-s govuk-!-margin-bottom-2">{{ set.madeFrom }}</p>
            {% endif %}
            {% if set.examples | length %}
              <h3 class="govuk-heading-s govuk-!-margin-top-4 govuk-!-margin-bottom-1">
                Examples<span class="govuk-visually-hidden"> in {{ set.text }}</span>
              </h3>
              <ul class="govuk-list govuk-list--bullet">
                {% for example in set.examples %}
                  <li>
                    <a class="govuk-link" href="{{ example.href }}">{{ example.text }}<span class="govuk-visually-hidden"> ({{ set.text }})</span></a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
            {% if canReset %}
              <form method="post" action="{{ set.resetAction }}" novalidate>
                <input type="hidden" name="crumb" value="{{ crumb }}" />
                {{ govukButton({
                  text: "Reset this prototype’s data",
                  classes: "govuk-button--secondary govuk-!-margin-bottom-0"
                }) }}
              </form>
            {% else %}
              <p class="govuk-body govuk-!-margin-bottom-0">
                Sign in to reset this prototype’s data.
              </p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
{% endblock %}
