{% extends "plants-working/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "shared/section-caption.njk" import sectionCaption %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  {% if deletionSucceeded %}
    {{ govukNotificationBanner({
      type: "success",
      titleText: sharedCopy.notificationActions.delete.successTitle,
      text: sharedCopy.notificationActions.delete.successBody,
      role: "alert"
    }) }}
  {% endif %}

  {{ sectionCaption(caption, "govuk-caption-xl") }}
  <h1 class="govuk-heading-xl">{{ copy.title }}</h1>
  {% if guidanceUrl %}
    <p class="govuk-body">
      <a class="govuk-link" href="{{ guidanceUrl }}">{{ copy.guidanceLink }}</a>
    </p>
  {% endif %}

  <form method="post" action="{{ startAction }}" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    {{ govukButton({ text: copy.startButton }) }}
  </form>

  <section class="app-plants-working-summary" aria-labelledby="summary-heading">
    <h2 class="govuk-heading-l" id="summary-heading">{{ copy.summary.heading }}</h2>
    <div class="app-plants-working-summary__items">
      <div class="app-plants-working-summary__item">
        <h3 class="app-plants-working-summary__title app-plants-working-summary__title--action">{{ copy.summary.actionNeeded }}</h3>
        <p class="app-plants-working-summary__hint">{{ copy.summary.actionNeededHint }}</p>
        <p class="app-plants-working-summary__count app-plants-working-summary__count--action">{{ counts.late }}</p>
        <p class="app-plants-working-summary__link"><a class="govuk-link" href="{{ actionNeededHref }}">{{ copy.summary.viewTasks }}</a></p>
      </div>
      <div class="app-plants-working-summary__item">
        <h3 class="app-plants-working-summary__title">{{ copy.summary.statusUpdated }}</h3>
        <p class="app-plants-working-summary__hint">{{ copy.summary.statusUpdatedHint }}</p>
        <p class="app-plants-working-summary__count app-plants-working-summary__count--updates">{{ counts.byStatus.submitted }}</p>
        <p class="app-plants-working-summary__link"><a class="govuk-link" href="{{ updatesHref }}">{{ copy.summary.viewUpdates }}</a></p>
      </div>
    </div>
  </section>

  <h2 class="govuk-heading-l">{{ copy.notificationsHeading }}</h2>

  <form method="get" action="{{ listAction }}" novalidate>
    <div class="app-plants-working-toolbar">
      <div class="app-plants-working-toolbar__search app-plants-working-search">
        {{ govukInput({
          id: "referenceNumber",
          name: "referenceNumber",
          label: { text: copy.search.label, classes: "govuk-label--s" },
          hint: { text: copy.search.hint },
          formGroup: { classes: "app-plants-working-search__field govuk-!-margin-bottom-0" },
          value: referenceNumber
        }) }}
        <button type="submit" class="app-plants-working-search__button">
          <svg class="app-plants-working-search__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M8 0a8 8 0 0 1 6.32 12.9l5.39 5.4-1.41 1.4-5.4-5.39A8 8 0 1 1 8 0Zm0 2a6 6 0 1 0 0 12A6 6 0 0 0 8 2Z" />
          </svg>
          <span class="govuk-visually-hidden">{{ copy.search.button }}</span>
        </button>
      </div>
      <div class="app-plants-working-toolbar__sort">
        {{ govukSelect({
          id: "sort",
          name: "sort",
          label: { text: copy.sort.label },
          formGroup: { classes: "govuk-!-margin-bottom-0" },
          items: sortOptions
        }) }}
      </div>
    </div>

    <details class="app-plants-working-filters"{% if filtersActive %} open{% endif %}>
      <summary class="app-plants-working-filters__summary">{{ copy.filters.show }}</summary>
      <div class="app-plants-working-filters__body">
        {{ govukCheckboxes({
          idPrefix: "status",
          name: "status",
          classes: "govuk-checkboxes--small",
          fieldset: { legend: { text: copy.filters.statusLegend, classes: "govuk-fieldset__legend--s" } },
          items: statusItems
        }) }}

        {{ govukInput({
          id: "commodity",
          name: "commodity",
          label: { text: copy.filters.commodity, classes: "govuk-label--s" },
          classes: "govuk-!-width-one-half",
          value: filters.commodity
        }) }}

        {{ govukCheckboxes({
          idPrefix: "late",
          name: "late",
          classes: "govuk-checkboxes--small",
          items: [{
            value: "yes",
            text: copy.filters.lateOnly ~ " (" ~ counts.late ~ ")",
            checked: filters.late == "yes"
          }]
        }) }}

        {{ govukDateInput({
          id: "dateFrom",
          namePrefix: "dateFrom",
          fieldset: { legend: { text: copy.filters.dateFrom, classes: "govuk-fieldset__legend--s" } },
          hint: { text: copy.filters.dateHint },
          errorMessage: dateFromError,
          items: [
            { name: "day", classes: "govuk-input--width-2", value: filters.dateFrom.day },
            { name: "month", classes: "govuk-input--width-2", value: filters.dateFrom.month },
            { name: "year", classes: "govuk-input--width-4", value: filters.dateFrom.year }
          ]
        }) }}

        {{ govukDateInput({
          id: "dateTo",
          namePrefix: "dateTo",
          fieldset: { legend: { text: copy.filters.dateTo, classes: "govuk-fieldset__legend--s" } },
          hint: { text: copy.filters.dateHint },
          errorMessage: dateToError,
          items: [
            { name: "day", classes: "govuk-input--width-2", value: filters.dateTo.day },
            { name: "month", classes: "govuk-input--width-2", value: filters.dateTo.month },
            { name: "year", classes: "govuk-input--width-4", value: filters.dateTo.year }
          ]
        }) }}

        {{ govukButton({ text: copy.filters.apply, classes: "govuk-button--secondary" }) }}
        <p class="govuk-body">
          <a class="govuk-link" href="{{ listAction }}">{{ copy.filters.clear }}</a>
        </p>
      </div>
    </details>
  </form>

  <div class="govuk-tabs">
    <h2 class="govuk-tabs__title">{{ copy.tabsLabel }}</h2>
    <ul class="govuk-tabs__list">
      {% for tab in tabLinks %}
        <li class="govuk-tabs__list-item{% if tab.current %} govuk-tabs__list-item--selected{% endif %}">
          <a class="govuk-tabs__tab" href="{{ tab.href }}"{% if tab.current %} aria-current="page"{% endif %}>{{ tab.text }} ({{ tab.count }})</a>
        </li>
      {% endfor %}
    </ul>
    <div class="govuk-tabs__panel" id="notifications-{{ openTab }}">
      <h3 class="govuk-heading-m">{{ copy.tabHeadings[openTab] }}</h3>
      <p class="govuk-visually-hidden">{{ resultsLabel }}</p>

      {% if notificationRows.length %}
        {% for row in notificationRows %}
          {% set postActions = row.actions | selectattr("postAction") %}
          <div class="app-plants-working-card{% if row.late %} app-plants-working-card--attention{% endif %}">
            <div class="app-plants-working-card__header">
              <div>
                <p class="app-plants-working-card__type">{{ row.commodity }}</p>
                <h4 class="app-plants-working-card__reference">{{ row.reference }}</h4>
              </div>
              <ul class="app-plants-working-card__actions">
                {% for action in row.actions | selectattr("href") %}
                  <li><a class="govuk-link" href="{{ action.href }}">{{ action.text }}<span class="govuk-visually-hidden"> {{ action.visuallyHiddenText }}</span></a></li>
                {% endfor %}
              </ul>
            </div>
            <dl class="app-plants-working-card__details">
              <div>
                <dt class="app-plants-working-card__key">{{ copy.table.commodity }}</dt>
                <dd class="app-plants-working-card__value">{{ row.commodity }}</dd>
              </div>
              <div>
                <dt class="app-plants-working-card__key">{{ copy.table.arrival }}</dt>
                <dd class="app-plants-working-card__value">{{ row.arrival }}</dd>
              </div>
              <div>
                <dt class="app-plants-working-card__key">{{ copy.table.consignor }}</dt>
                <dd class="app-plants-working-card__value">{{ row.consignor }}</dd>
              </div>
              <div>
                <dt class="app-plants-working-card__key">{{ copy.table.status }}</dt>
                <dd class="app-plants-working-card__value">
                  {{ govukTag({ text: row.status.text, classes: row.status.classes }) }}
                  {% if row.late %}
                    {{ govukTag({ text: copy.statusLate, classes: "govuk-tag--red" }) }}
                  {% endif %}
                </dd>
              </div>
              <div>
                <dt class="app-plants-working-card__key">{{ copy.table.origin }}</dt>
                <dd class="app-plants-working-card__value">{{ row.origin }}</dd>
              </div>
              <div>
                <dt class="app-plants-working-card__key">{{ copy.table.created }}</dt>
                <dd class="app-plants-working-card__value">{{ row.created }}</dd>
              </div>
              <div>
                <dt class="app-plants-working-card__key">{{ copy.table.submitted }}</dt>
                <dd class="app-plants-working-card__value">{{ row.submitted }}</dd>
              </div>
            </dl>
            {% if postActions.length %}
              <div class="app-plants-working-card__footer">
                {% for action in postActions %}
                  {% set actionHtml %}{{ action.text }}<span class="govuk-visually-hidden"> {{ action.visuallyHiddenText }}</span>{% endset %}
                  <form method="post" action="{{ action.postAction }}" novalidate>
                    <input type="hidden" name="crumb" value="{{ crumb }}" />
                    {{ govukButton({
                      html: actionHtml,
                      classes: "govuk-button--secondary govuk-!-margin-bottom-0"
                    }) }}
                  </form>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      {% elif filtersActive or referenceNumber %}
        <p class="govuk-body">{{ copy.filters.noMatches }}</p>
        <p class="govuk-body">
          <a class="govuk-link" href="{{ listAction }}">{{ copy.filters.clear }}</a>
        </p>
      {% else %}
        <p class="govuk-body">{{ copy.emptyText }}</p>
      {% endif %}

      {% if pagination %}
        {{ govukPagination(pagination) }}
      {% endif %}
    </div>
  </div>
{% endblock %}
