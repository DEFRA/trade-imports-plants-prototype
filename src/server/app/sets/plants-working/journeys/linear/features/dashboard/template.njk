{% extends "shared/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "shared/section-caption.njk" import sectionCaption %}

{% block journeyContent %}
  {% if deletionSucceeded %}
    {{ govukNotificationBanner({
      type: "success",
      titleText: sharedCopy.notificationActions.delete.successTitle,
      text: sharedCopy.notificationActions.delete.successBody,
      role: "alert"
    }) }}
  {% endif %}

  {{ sectionCaption(caption, "govuk-caption-xl") }}
  <h1 class="govuk-heading-xl">{{ copy.title }}</h1>
  <p class="govuk-body">{{ copy.body }}</p>
  {% if guidanceUrl %}
    <p class="govuk-body">
      <a class="govuk-link" href="{{ guidanceUrl }}">{{ copy.guidanceLink }}</a>
    </p>
  {% endif %}

  <form method="post" action="{{ startAction }}" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    {{ govukButton({ text: copy.startButton, isStartButton: true }) }}
  </form>

  <h2 class="govuk-heading-m">{{ copy.notificationsHeading }}</h2>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-third">
      <h3 class="govuk-heading-m">{{ copy.search.heading }}</h3>

      <form method="get" action="{{ listAction }}">
        {% if sort %}
          <input type="hidden" name="sort" value="{{ sort }}" />
        {% endif %}
        {{ govukInput({
          id: "referenceNumber",
          name: "referenceNumber",
          label: { text: copy.search.label, classes: "govuk-label--s" },
          value: referenceNumber
        }) }}
        {{ govukButton({ text: copy.search.button }) }}
      </form>
    </div>

    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body govuk-!-font-weight-bold">{{ resultsLabel }}</p>

      <form method="get" action="{{ listAction }}">
        {% if currentPage > 1 %}
          <input type="hidden" name="page" value="{{ currentPage }}" />
        {% endif %}
        {% if referenceNumber %}
          <input type="hidden" name="referenceNumber" value="{{ referenceNumber }}" />
        {% endif %}
        {{ govukSelect({
          id: "sort",
          name: "sort",
          label: { text: copy.sort.label, classes: "govuk-label--s" },
          items: sortOptions
        }) }}
        {{ govukButton({ text: copy.sort.update, classes: "govuk-button--secondary" }) }}
      </form>

      {% if notificationRows.length %}
        {% for row in notificationRows %}
          {% set statusHtml %}
            {{ govukTag({ text: row.status.text, classes: row.status.classes }) }}
            {% if row.late %}
              {{ govukTag({ text: copy.statusLate, classes: "govuk-tag--red" }) }}
            {% endif %}
          {% endset %}

          {% set postActions = row.actions | selectattr("postAction") %}
          {% set postActionsHtml %}
            {% for action in postActions %}
              {% set actionHtml %}{{ action.text }}<span class="govuk-visually-hidden"> {{ action.visuallyHiddenText }}</span>{% endset %}
              <form method="post" action="{{ action.postAction }}" novalidate>
                <input type="hidden" name="crumb" value="{{ crumb }}" />
                {{ govukButton({
                  html: actionHtml,
                  classes: "govuk-button--secondary govuk-!-margin-bottom-0"
                }) }}
              </form>
            {% endfor %}
          {% endset %}

          {% set detailRows = [
            { key: { text: copy.table.commodity }, value: { text: row.commodity } },
            { key: { text: copy.table.origin }, value: { text: row.origin } },
            { key: { text: copy.table.arrival }, value: { text: row.arrival } },
            { key: { text: copy.table.consignor }, value: { text: row.consignor } },
            { key: { text: copy.table.status }, value: { html: statusHtml } },
            { key: { text: copy.table.created }, value: { text: row.created } },
            { key: { text: copy.table.submitted }, value: { text: row.submitted } }
          ] %}
          {% set actionRows = [
            { key: { text: copy.table.actions }, value: { html: postActionsHtml } }
          ] if postActions.length else [] %}

          {{ govukSummaryList({
            card: {
              title: { text: row.reference, headingLevel: 3 },
              actions: { items: row.actions | selectattr("href") }
            },
            rows: detailRows.concat(actionRows)
          }) }}
        {% endfor %}
      {% elif not referenceNumber %}
        <p class="govuk-body">{{ copy.emptyText }}</p>
      {% endif %}

      {% if pagination %}
        {{ govukPagination(pagination) }}
      {% endif %}
    </div>
  </div>
{% endblock %}
