{% extends "shared/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/task-list/macro.njk" import govukTaskList %}

{% block journeyContent %}
  <h1 class="govuk-heading-xl">{{ heading }}</h1>

  <section aria-labelledby="task-list-heading">
    <h2 class="govuk-heading-l" id="task-list-heading">{{ copy.taskListHeading }}</h2>

    {% for group in groups %}
      <section aria-labelledby="{{ group.id }}-heading">
        <h3 class="govuk-heading-m" id="{{ group.id }}-heading">{{ group.caption }}</h3>
        {{ govukTaskList({
          idPrefix: group.id,
          items: group.items,
          classes: "govuk-!-margin-bottom-8"
        }) }}
      </section>
    {% endfor %}
  </section>

  {{ govukButton({
    text: copy.returnToDashboard,
    href: dashboardHref,
    classes: "govuk-button--secondary"
  }) }}
{% endblock %}
