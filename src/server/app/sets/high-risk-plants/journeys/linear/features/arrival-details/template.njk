{% extends "shared/layout.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "moj/components/date-picker/macro.njk" import mojDatePicker %}
{% from "accessible-autocomplete/macro.njk" import appAccessibleAutocomplete %}
{% from "shared/save-actions.njk" import saveActions %}
{% from "shared/section-caption.njk" import sectionCaption %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  {{ sectionCaption(caption) }}
  <h1 class="govuk-heading-l">{{ copy.title }}</h1>

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />

    {{ mojDatePicker(dateField) }}

    {% if showPotatoFields %}
      {{ govukInput({
        id: "arrivalTime",
        name: "arrivalTime",
        classes: "govuk-input--width-5",
        label: { text: copy.time.label, classes: questionLabelClasses },
        hint: { text: copy.time.hint },
        value: values.arrivalTime,
        errorMessage: errors.arrivalTime and { text: errors.arrivalTime }
      }) }}

      {{ appAccessibleAutocomplete({
        id: "proposedPlaceOfLanding",
        name: "proposedPlaceOfLanding",
        label: { text: copy.placeOfLanding.label, classes: questionLabelClasses },
        hint: { text: copy.placeOfLanding.hint },
        value: values.proposedPlaceOfLanding,
        errorMessage: errors.proposedPlaceOfLanding and { text: errors.proposedPlaceOfLanding },
        items: portItems,
        autocomplete: {
          showAllValues: true,
          noResults: copy.placeOfLanding.noResults,
          placeholder: copy.placeOfLanding.searchPlaceholder
        }
      }) }}
    {% endif %}

    {{ saveActions({ hubHref: hubHref, copy: sharedCopy.saveActions, amend: amend }) }}
  </form>
{% endblock %}
